# BlinkTalk settings. Copy this file to .env (gitignored) and fill it in. Real environment variables win.
# Everything is optional: with an empty file BlinkTalk runs with built-in reply suggestions, simulated
# texting and the keyboard standing in for the eyes.

# --- Patient
BLINKTALK_PATIENT=neal

# --- SK-AM62B board (serial console; find the COM port with: npm run ports)
# The hub logs in and starts the eye-command model on the board by itself. Leave empty for no board.
BOARD_PORT=COM12
BOARD_SENSITIVITY=5            # 1 strict (fewer false commands) .. 10 sensitive; 5 = tested default
BOARD_LED=12                   # PPG LED current (board: python3 afe4950.py --led-sweep picks one)
BOARD_SWAP_LR=0                # 1 if the electrodes are mirrored (red beside the LEFT eye)
BOARD_DIR=/root/blinktalk      # where the board software lives on the board

# --- AI model: any OpenAI-compatible chat-completions endpoint. Check it with: npm run llm-check
# Azure AI Foundry (default):
AI_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1
AI_MODEL=<your-deployment-name>
AI_API_KEY=
# ...or a model on this computer, no key and no internet needed (Ollama):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3:8b
AI_VISION_MODEL=               # optional separate model for describing photos (default: AI_MODEL)
AI_TIMEOUT=20                  # seconds per request
AI_REASONING_EFFORT=low        # minimal | low | medium | high; keeps reasoning models fast (dropped if the model refuses it)
AI_API=auto                    # chat | responses | auto (chat first, switches to the Responses API if the deployment needs it)

# --- iMessage through Photon (app.beta.photon.codes -> API keys, project:read + project:write)
# Leave empty for simulated texting (the dashboard's "Send a test text" box).
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# --- SpacetimeDB (local: ws://localhost:3000; cloud: wss://maincloud.spacetimedb.com)
SPACETIME_URI=ws://localhost:3000
SPACETIME_DB=blinktalk
